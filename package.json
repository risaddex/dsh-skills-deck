{
  "name": "dsh-skills-deck",
  "version": "2.0.0-alpha.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/risaddex/dsh-skills-deck.git"
  },
  "private": true,
  "main": "package/lib/index.js",
  "exports": {
    ".": "./package/lib/index.js",
    "./client": "./package/lib/client.js",
    "./tools": "./package/deck/registration/agent-row.js",
    "./cordis.patch.yml": "./package/cordis.patch.yml",
    "./package.json": "./package/package.json"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "node scripts/generate-locale-config.mts --check && node scripts/generate-prompt-config.mts --check && node scripts/generate-time-config.mts --check && node scripts/generate-md-format-config.mts --check && node scripts/typecheck.mts",
    "prepare": "node scripts/build.mts",
    "test": "npm run typecheck && node scripts/build.mts && node scripts/verify-chain.ts && npm run test:smoke",
    "smoke": "node --import ./scripts/ts-hook.mts tests/smoke-client.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-host-dispatch.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-render.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-naming-persistence.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-comment-passthrough.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-snapshot-github.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-snapshot-gitlab.test.ts && node --import ./scripts/ts-hook.mts tests/smoke-snapshot-markdown.test.ts",
    "test:smoke": "node scripts/verify-chain.ts --script smoke",
    "test:nobuild": "node scripts/verify-chain.ts && npm run test:smoke",
    "verify:parallel": "node scripts/verify-parallel.mts --keep-going --json node_modules/.cache/dsh-verify-last.json",
    "verify:fast": "node scripts/verify-parallel.mts --tier fast",
    "verify:changed": "node scripts/verify-parallel.mts --changed",
    "verify:last": "node scripts/verify-last.mts",
    "verify": "node scripts/verify-chain.ts",
    "verify:self-check": "dsh-verify self-check --profile web",
    "verify:self-check:json": "dsh-verify self-check --profile web --json",
    "verify:acceptance": "dsh-verify single-instance --profile web",
    "verify:ui": "node --import ./scripts/ts-hook.mts node_modules/dsh-featherhunter-plugin-base/dist/real-machine-verification/cli/main.js run verify/scenarios/ui.ts",
    "verify:smoke": "node --import ./scripts/ts-hook.mts node_modules/dsh-featherhunter-plugin-base/dist/real-machine-verification/cli/main.js run verify/scenarios/smoke.ts",
    "sync:matt": "node scripts/sync-matt-skills.mts --verify"
  },
  "dependencies": {
    "dsh-log": "^0.4.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "dependency-cruiser": "^18.6.0",
    "dsh-featherhunter-plugin-base": "https://codeload.github.com/risaddex/dsh-featherhunter-plugin-base/tar.gz/cff1a0221ee9a08b2ac926de81d9f912627f5270",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dsh": {
    "bundle": {
      "mode": "patch",
      "patch": "./package/cordis.patch.yml"
    }
  }
}
